            </span>
            <h1 className="text-2xl font-black text-slate-900">{product.name}</h1>
            <p className="text-xs text-slate-400 mt-1">Tỷ lệ quy đổi: 1 {product.unit} = {product.conversion_rate} {product.base_unit}</p>
