          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1">Mật Khẩu:</label>
            <div className="relative">
              <Lock className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
              <input
                type="password"
                required
                placeholder="••••••••"
