                      {isImport ? `+${t.quantity}` : `${t.quantity}`} {t.products?.base_unit || 'Cơ sở'}
                    </td>
                    <td className="p-4 font-mono text-xs font-semibold text-slate-700 whitespace-nowrap">
                      {t.reference_id || '-'}
                    </td>
                    <td className="p-4 text-xs text-slate-500 max-w-[250px] truncate">
                      {t.notes || '-'}
                    </td>
                  </tr>
                )
